# ===== Wajib diganti =====
# Password database Postgres (dipakai container db, web, worker)
POSTGRES_PASSWORD=ganti-password-database

# Rahasia sesi login dashboard (better-auth) — string acak panjang, mis. hasil: openssl rand -hex 32
BETTER_AUTH_SECRET=ganti-dengan-string-acak-panjang

# Kunci enkripsi password/token akun Threads — string acak panjang (JANGAN diganti setelah dipakai)
SECRET_KEY=ganti-dengan-string-acak-panjang-lain

# ===== Akses dashboard =====
# Domain HTTPS (profil https). Tanpa beli domain pakai sslip.io + IP VPS:
DOMAIN=comel.203-0-113-5.sslip.io
# URL publik dashboard (harus sama dengan alamat yang dibuka di browser)
BETTER_AUTH_URL=https://comel.203-0-113-5.sslip.io

# ===== Opsional =====
# SCRAPE_CONCURRENCY=2
# THREADS_GRAPH_BASE=https://graph.threads.net/v1.0
# BETTER_AUTH_TRUSTED_ORIGINS=https://alamat-lain.com
