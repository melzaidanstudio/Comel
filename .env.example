# Password untuk masuk dashboard (WAJIB diganti)
ADMIN_PASSWORD=ganti-dengan-password-kuat

# Port dashboard
PORT=3000

# Domain untuk HTTPS (profil https). Tanpa beli domain pakai sslip.io + IP VPS, contoh:
# DOMAIN=comel.203-0-113-5.sslip.io
DOMAIN=

# Kunci enkripsi password akun (opsional; default dibuat otomatis di data/.secret_key)
# SECRET_KEY=string-acak-panjang

# Opsional
# TZ=Asia/Jakarta
# SCRAPE_CONCURRENCY=2
# LIGHTPANDA_BIN=/usr/local/bin/lightpanda
# CHROMIUM_PATH=/path/ke/chrome      # kalau tidak pakai Chromium bawaan Playwright
# THREADS_GRAPH_BASE=https://graph.threads.net/v1.0
